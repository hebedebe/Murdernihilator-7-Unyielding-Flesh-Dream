[sub_resource type="GDScript" id="GDScript_cwpch"]
script/source = "extends Camera3D

@export var MAX_ROT: float = 3
@export var VEL_STR: float = 0.01

@onready var player: Player = $\"../..\"

func _process(delta: float) -> void:
	var global_velocity = player.velocity * player.global_basis
	rotation.z = lerp(rotation.z, clamp(-global_velocity.x * VEL_STR, -MAX_ROT, MAX_ROT), 5 * delta)
	rotation.x = lerp(rotation.x, clamp((global_velocity.z + 
	global_velocity.y) * VEL_STR, -MAX_ROT, MAX_ROT), 5* delta)
	
	position.y = 0.015 * global_velocity.length() * sin(0.017 * Time.get_ticks_msec());
"

[sub_resource type="GDScript" id="GDScript_e2ks3"]
script/source = "extends Node3D

@export var rotation_amount: float = 0.5
@export var return_strength: float = 15.0
@export var position_offset: Vector3 = Vector3.ZERO

@onready var player: Player = $\"../../..\"

var target_position: Vector3 = Vector3.ZERO

func _process(delta: float) -> void:
	rotation = rotation.lerp(Vector3.ZERO, return_strength * delta)
	target_position = target_position.lerp(position_offset, return_strength * delta)
	position = position.lerp(target_position, return_strength * delta)
	
	var global_velocity = player.velocity * player.global_basis
	
	target_position = Vector3(
		global_velocity.x,
		-global_velocity.z,
		global_velocity.y
	) * 0.005
	


func _on_input_component_look_input(delta: Vector2) -> void:
	rotation.y += delta.x * rotation_amount
	rotation.x += delta.y * rotation_amount
"

[sub_resource type="GDScript" id="GDScript_rbp5l"]
script/source = "extends Node3D

@export var rotation_amount: float = 0.5
@export var return_strength: float = 15.0

func _process(delta: float) -> void:
	rotation = rotation.lerp(Vector3.ZERO, return_strength * delta)


func _on_input_component_look_input(delta: Vector2) -> void:
	rotation.y -= delta.x * rotation_amount
	rotation.x -= delta.y * rotation_amount
"

[sub_resource type="GDScript" id="GDScript_a4xvd"]
script/source = "extends Node3D

@export var rotation_amount: float = 0.5
@export var return_strength: float = 15.0

@onready var player: Player = $\"../../../../..\"

var target_position: Vector3 = Vector3.ZERO

func _process(delta: float) -> void:
	rotation = rotation.lerp(Vector3.ZERO, return_strength * delta)
	target_position = target_position.lerp(Vector3.ZERO, return_strength * delta)
	position = position.lerp(target_position, return_strength * delta)
	
	var global_velocity = player.velocity * player.global_basis
	
	target_position = Vector3(
		global_velocity.x,
		-global_velocity.z,
		global_velocity.y
	) * 0.01
	


func _on_input_component_look_input(delta: Vector2) -> void:
	rotation.y -= delta.x * rotation_amount
	rotation.x += delta.y * rotation_amount
"

[sub_resource type="GDScript" id="GDScript_2smj8"]
script/source = "extends Node3D

@export var rotation_amount: float = 0.5
@export var return_strength: float = 15.0

@onready var trail_source: Node3D = $\"../../../../../Camera3D/TrailSource\"
@onready var camera_3d: Camera3D = $\"../../../../../Camera3D\"
@onready var ray_cast_3d: RayCast3D = $\"../../../../../Camera3D/RayCast3D\"
@onready var muzzle: Node3D = $Muzzle
@onready var muzzle_flash: AnimatedSprite3D = $Muzzle/MuzzleFlash

func _process(delta: float) -> void:
	rotation = rotation.lerp(Vector3.ZERO, return_strength * delta)
	position = position.lerp(Vector3.ZERO, return_strength * delta)

func fire():
	if !%Ammo.has_ammo():
		return
	
	%Ammo.fire()
	
	
	rotation.x += 0.8
	position.y -= 0.02
	ray_cast_3d.force_raycast_update()
	var endpoint: Vector3
	if ray_cast_3d.is_colliding():
		endpoint = ray_cast_3d.get_collision_point()
		var col = ray_cast_3d.get_collider()
		if col is Dummy:
			var particle = preload(\"res://FX/Particles/Hit/alien_hit_particles.tscn\").instantiate()
			col.add_child(particle)
			particle.global_position = endpoint
			particle.restart()
			(col.get_node(\"%KnockbackComponent\") as KnockbackComponent).knockback(10, ray_cast_3d.global_basis)
	else:
		endpoint = ray_cast_3d.to_global(ray_cast_3d.target_position + ray_cast_3d.position)
	#var draw: Draw3D = Draw3D.new()
	#add_child(draw)
	#draw.line(
		#trail_source.global_position, 
		#endpoint,
		#Color.RED,
		#0.7
	#)
	#muzzle_flash.position = muzzle.global_position
	muzzle_flash.stop()
	muzzle_flash.play(\"default\")
	
	var tween = create_tween()
	tween.tween_property(camera_3d, \"rotation\", camera_3d.rotation + Vector3(PI/24, 0, 0), 0.05)
	tween.play()

func reload():
	rotation.x += 2*PI
"

