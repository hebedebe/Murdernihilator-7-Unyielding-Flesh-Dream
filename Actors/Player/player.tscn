[sub_resource type="GDScript" id="GDScript_4k5fm"]
script/source = "extends TextureRect

@onready var ray_cast_3d: RayCast3D = $\"../../Neck/Camera3D/RayCast3D\"
@onready var camera_3d: Camera3D = $\"../../Neck/Camera3D\"
@onready var hud: CanvasLayer = $\"..\"

var target_location: Vector2 = Vector2.ZERO

func _process(delta: float) -> void:
	ray_cast_3d.force_raycast_update()
	var collision_point
	if ray_cast_3d.is_colliding():
		collision_point = ray_cast_3d.get_collision_point()
	else:
		collision_point = ray_cast_3d.to_global(ray_cast_3d.target_position + ray_cast_3d.position)
		
	var screen_location = camera_3d.unproject_position(collision_point)
	target_location = screen_location
	position = position.lerp(target_location, 1)
"

